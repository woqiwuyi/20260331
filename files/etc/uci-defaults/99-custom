#!/bin/sh
# 首次启动执行，执行后自动删除
# Newifi D2 OC1100 定制：主机名/时区、SFO 开 HFO 关、双 WAN (mwan3) 3:1
# 线路：wan=300M(原WAN口)，wanb=100M(LAN1口)，balanced 按 3:1 分流
# 增强：按设备钉线、链路质量检测(check_quality)、流量统计(vnstat2)、
#       禁用 IPv6、FullCone 已放弃(官方内核不支持)、每周定时重启、conntrack 调优

uci set system.@system[0].hostname='newifi-d2-oc'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'

# 软件流卸载：开；硬件加速：关
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='0'

# ------------------------------------------------------------------
# 双 WAN：把 lan1 (switch port@3) 划为第二个 WAN，接口名 wanb
#   - 物理口：原 WAN=port4(wan) 接 300M；新增 WAN2=lan1(port3) 接 100M
#   - 保留 lan2/lan3/lan4 在 br-lan 作为 LAN
# ------------------------------------------------------------------

# 1) 从所有 bridge device 的 ports 中移除 lan1
for dev in $(uci show network | sed -n "s/^network\.\([^.]*\)\.ports=.*/\1/p"); do
    uci -q del_list "network.${dev}.ports=lan1"
done

# 2) 新建第二 WAN 接口 wanb，绑定 lan1，DHCP 客户端
uci -q set network.wanb=interface
uci -q set network.wanb.device='lan1'
uci -q set network.wanb.proto='dhcp'

# 3) 防火墙：把 wanb 加入 wan 区域
for zone in $(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='wan'.*/\1/p"); do
    uci -q add_list "firewall.${zone}.network=wanb"
done
if [ -z "$(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='wan'.*/\1/p")" ]; then
    for zone in $(uci show firewall | sed -n "s/^firewall\.\([^.]*\)\.name=wan$/\1/p"); do
        uci -q add_list "firewall.${zone}.network=wanb"
    done
fi

# ------------------------------------------------------------------
# 4) mwan3 配置
# ------------------------------------------------------------------
uci -q set mwan3.wanb.enabled='1'

# 4a) 追踪 IP 换成国内 DNS（移动网络下境外 IP 常不通，会误判掉线）
for iface in wan wanb; do
    uci -q delete "mwan3.${iface}.track_ip"
    uci -q add_list "mwan3.${iface}.track_ip=223.5.5.5"
    uci -q add_list "mwan3.${iface}.track_ip=119.29.29.29"
    uci -q add_list "mwan3.${iface}.track_ip=223.6.6.6"
done

# 4b) 链路质量检测：延迟>400ms 或丢包>30% 判为链路劣化，恢复阈值更宽松
#     (移动网络晚高峰拥塞时 ping 仍通但延迟飙升，此功能让 mwan3 感知并切换)
for iface in wan wanb; do
    uci -q set "mwan3.${iface}.check_quality=1"
    uci -q set "mwan3.${iface}.failure_latency=400"
    uci -q set "mwan3.${iface}.recovery_latency=200"
    uci -q set "mwan3.${iface}.failure_loss=30"
    uci -q set "mwan3.${iface}.recovery_loss=10"
done

# 4c) 3:1 分流：wan(weight 3) : wanb(weight 1)
uci -q set mwan3.wanb_m1_w1=member
uci -q set mwan3.wanb_m1_w1.interface='wanb'
uci -q set mwan3.wanb_m1_w1.metric='1'
uci -q set mwan3.wanb_m1_w1.weight='1'
uci -q del_list mwan3.balanced.use_member='wanb_m1_w3'
uci -q add_list mwan3.balanced.use_member='wanb_m1_w1'

# 4d) 按设备钉线（PBR）：rule 按配置顺序匹配，必须先于 default_rule_v4。
#     UCI 新建 section 排在末尾，因此删掉默认 rule 后按优先级顺序重建。
#     示例：192.168.1.2 固定走 300M(wan)，192.168.1.3 固定走 100M(wanb)。
#     改成自己的设备 IP 即可；sticky=1 保证该设备会话不跨线。
uci -q delete mwan3.https
uci -q delete mwan3.default_rule_v4
uci -q delete mwan3.default_rule_v6

uci -q set mwan3.pin_w300=rule
uci -q set mwan3.pin_w300.src_ip='192.168.1.2'
uci -q set mwan3.pin_w300.family='ipv4'
uci -q set mwan3.pin_w300.proto='all'
uci -q set mwan3.pin_w300.sticky='1'
uci -q set mwan3.pin_w300.use_policy='wan_only'

uci -q set mwan3.pin_w100=rule
uci -q set mwan3.pin_w100.src_ip='192.168.1.3'
uci -q set mwan3.pin_w100.family='ipv4'
uci -q set mwan3.pin_w100.proto='all'
uci -q set mwan3.pin_w100.sticky='1'
uci -q set mwan3.pin_w100.use_policy='wanb_only'

# https 粘性规则（默认 443 走 balanced，避免同会话换 IP 掉登录）
uci -q set mwan3.https=rule
uci -q set mwan3.https.sticky='1'
uci -q set mwan3.https.dest_port='443'
uci -q set mwan3.https.proto='tcp'
uci -q set mwan3.https.use_policy='balanced'

# 默认规则放最后
uci -q set mwan3.default_rule_v4=rule
uci -q set mwan3.default_rule_v4.dest_ip='0.0.0.0/0'
uci -q set mwan3.default_rule_v4.use_policy='balanced'
uci -q set mwan3.default_rule_v4.family='ipv4'
uci -q set mwan3.default_rule_v6=rule
uci -q set mwan3.default_rule_v6.dest_ip='::/0'
uci -q set mwan3.default_rule_v6.use_policy='balanced'
uci -q set mwan3.default_rule_v6.family='ipv6'

# ------------------------------------------------------------------
# 5) 禁用 IPv6：避免浏览器优先走 IPv6 绕过 mwan3 分流，也减少固件体积
# ------------------------------------------------------------------
# 删除 WAN6 接口（DHCPv6 客户端）
uci -q delete network.wan6
# 关闭 LAN 的 IPv6 前缀下发与 RA
uci -q delete network.lan.ip6assign
for dhcpsec in $(uci show dhcp | sed -n "s/^dhcp\.\([^.]*\)\.ra=.*/\1/p"); do
    uci -q set "dhcp.${dhcpsec}.ra=disabled"
    uci -q set "dhcp.${dhcpsec}.dhcpv6=disabled"
done
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
# 禁用 odhcpd 服务（IPv6 的 DHCP/RA 由它负责）
/etc/init.d/odhcpd disable >/dev/null 2>&1 || true
# mwan3 的 IPv6 接口默认已 disabled，无需改动

# ------------------------------------------------------------------
# 6) vnstat2 流量统计：监控两条 WAN
# ------------------------------------------------------------------
uci -q delete vnstat.@vnstat[0]
uci -q set vnstat.main=vnstat
uci -q add_list vnstat.main.interface='wan'
uci -q add_list vnstat.main.interface='wanb'
/etc/init.d/vnstat enable >/dev/null 2>&1 || true

# ------------------------------------------------------------------
# 7) 连接跟踪表调优：512MB RAM 充足，加大表项与 established 超时
# ------------------------------------------------------------------
mkdir -p /etc/sysctl.d
cat > /etc/sysctl.d/99-custom.conf <<'SYSEOF'
net.netfilter.nf_conntrack_max=32768
net.netfilter.nf_conntrack_tcp_timeout_established=86400
net.netfilter.nf_conntrack_udp_timeout_stream=180
SYSEOF

# ------------------------------------------------------------------
# 8) 每周定时重启：周一 04:00，清理内存碎片与残留连接
# ------------------------------------------------------------------
mkdir -p /etc/crontabs
grep -q '/sbin/reboot' /etc/crontabs/root 2>/dev/null || \
    echo '0 4 * * 1 /sbin/reboot' >> /etc/crontabs/root
/etc/init.d/cron enable >/dev/null 2>&1 || true

uci commit

# 9) 确保服务开机自启
/etc/init.d/mwan3 enable >/dev/null 2>&1 || true

exit 0
