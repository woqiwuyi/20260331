CONFIG_CCACHE=y

# 基础系统
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-offload=y

# 多 WAN
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# 流量统计（25.12 中包名为 vnstat2 / luci-app-vnstat2）
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_luci-app-vnstat2=y

# PPPoE（如不需要可改为 n）
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# 明确删除
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_wol=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_sqm-scripts=n
CONFIG_PACKAGE_luci-app-turboacc=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_blockd=n

# 无 USB
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb2=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_kmod-usb-serial=n
CONFIG_PACKAGE_usbutils=n

# 无无线
CONFIG_PACKAGE_kmod-mt7603e=n
CONFIG_PACKAGE_kmod-mt76x2e=n
CONFIG_PACKAGE_mt7603e-firmware=n
CONFIG_PACKAGE_mt7612e-firmware=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_wpa-supplicant=n
